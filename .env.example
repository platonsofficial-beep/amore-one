# Supabase (required for production; also needed when VITE_AUTH_DISABLED=false)
VITE_SUPABASE_URL=
# Use either publishable key (preferred) or legacy anon key name:
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Set to true to skip login during local development only
VITE_AUTH_DISABLED=true
