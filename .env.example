# Supabase (required for production; also needed when VITE_AUTH_DISABLED=false)
VITE_SUPABASE_URL=
# Use either publishable key (preferred) or legacy anon key name:
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Set to true to skip login during local development only
VITE_AUTH_DISABLED=true

# Public links people copy or receive by email. Unset uses https://app.onehospitality.app.
# Local Vite dev still uses localhost for on-screen copy links.
# VITE_PUBLIC_APP_URL=https://app.onehospitality.app
